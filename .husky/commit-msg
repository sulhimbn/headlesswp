#!/bin/sh

PATTERN="^(feat|fix|docs|style|refactor|test|chore|perf|ci|INNOVATION|QA|DX|SECURITY)(\\([a-zA-Z0-9_-]+\\))?: .+"

commit_msg=$(cat "$1")

if ! echo "$commit_msg" | grep -qE "$PATTERN"; then
  echo "Invalid commit message format."
  echo "Must match: type(scope): description"
  echo "Types: feat:, fix:, docs:, style:, refactor:, test:, chore:, perf:, ci:, INNOVATION:, QA:, DX:, SECURITY:"
  exit 1
fi