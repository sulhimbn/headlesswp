{
  "name": "headlesswp",
  "version": "1.0.0",
  "description": "WordPress Headless untuk mitrabantennews.com",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true next build --webpack",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:a11y": "jest --testPathPatterns=accessibility",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:full": "npm audit --audit-level=low",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "size-check": "node scripts/bundle-size-check.js",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.40.0",
    "axios": "^1.20.0",
    "isomorphic-dompurify": "^2.36.0",
    "next": "^16.3.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.1.6",
    "@playwright/test": "1.64.0",
    "@size-limit/file": "^12.0.1",
    "@size-limit/preset-app": "^12.0.0",
    "@size-limit/webpack": "^12.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.53.1",
    "autoprefixer": "10.6.1",
    "baseline-browser-mapping": "^2.11.26",
    "eslint": "^10.0.3",
    "jest": "^30.3.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "8.5.29",
    "size-limit": "^12.0.1",
    "tailwindcss": "3.4.19",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "wordpress",
    "headless",
    "nextjs",
    "react",
    "rest-api"
  ],
  "author": "Mitra Banten News",
  "license": "MIT",
  "overrides": {
    "js-yaml": "^4.3.2",
    "caniuse-lite": "^1.0.30001774",
    "undici": "^7.29.1",
    "serialize-javascript": "^7.0.5",
    "flatted": "^3.4.2",
    "dompurify": "^3.4.16",
    "handlebars": "^4.7.9",
    "picomatch": ">=2.3.2 <4.0.0 || >=4.0.7",
    "ws": "^8.22.0",
    "form-data": "^4.0.6",
    "fast-uri": "^3.1.8",
    "browserslist": "^4.29.3",
    "follow-redirects": "^1.16.0",
    "basic-ftp": "^5.3.1",
    "ip-address": "^10.7.2"
  }
}
